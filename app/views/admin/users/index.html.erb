<% content_for :title, t("admin.users.title") %>

<div class="card">
  <h1><%= t("admin.users.title") %></h1>
  <p class="hint"><%= t("admin.users.intro") %></p>

  <table>
    <thead>
      <tr>
        <th><%= User.human_attribute_name(:name) %></th>
        <th><%= User.human_attribute_name(:email_address) %></th>
        <th><%= User.human_attribute_name(:role) %></th>
        <th><%= t("admin.users.status") %></th>
        <th><%= t("admin.users.actions") %></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td>
            <%= user.name %>
            <% if user == current_user %>
              <span class="muted"><%= t("admin.users.you") %></span>
            <% end %>
          </td>
          <td><%= user.email_address %></td>
          <td><%= user.role_name %></td>
          <td>
            <% if user.locked? %>
              <span class="muted"><%= t("admin.users.locked_since", time: l(user.locked_at, format: :short)) %></span>
            <% else %>
              <%= t("admin.users.active") %>
            <% end %>
          </td>
          <td class="actions">
            <%= link_to t("admin.users.edit"), edit_admin_user_path(user), class: "button button-secondary" %>

            <% if user.locked? %>
              <%= button_to t("admin.users.unlock"), unlock_admin_user_path(user), method: :patch,
                            class: "button button-secondary" if policy(user).unlock? %>
            <% elsif policy(user).lock? %>
              <%= button_to t("admin.users.lock"), lock_admin_user_path(user), method: :patch,
                            class: "button button-secondary" %>
            <% end %>

            <%# Link statt Button: ein versehentlicher Klick öffnet nur die
                Bestätigungsseite und löscht noch nichts. %>
            <% if policy(user).confirm_destroy? %>
              <%= link_to t("admin.users.destroy"), confirm_destroy_admin_user_path(user),
                          class: "button button-secondary" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
