<% content_for :title, t("admin.users.confirm_title", name: @user.name) %>

<div class="card form-narrow">
  <h1><%= t("admin.users.confirm_title", name: @user.name) %></h1>

  <div class="errors" role="alert">
    <strong><%= t("admin.users.confirm_warning") %></strong>
  </div>

  <p><strong><%= User.human_attribute_name(:email_address) %>:</strong> <%= @user.email_address %></p>
  <p><strong><%= User.human_attribute_name(:role) %>:</strong> <%= @user.role_name %></p>

  <ul>
    <li><%= t("admin.users.confirm_ratings", count: @user.ratings.count) %></li>
    <li><%= t("admin.users.confirm_products", count: @user.products.count) %></li>
  </ul>

  <div class="actions">
    <%= button_to t("admin.users.destroy_final"), admin_user_path(@user), method: :delete,
                  class: "button" %>
    <%= link_to t("forms.cancel"), admin_users_path, class: "button button-secondary" %>
  </div>
</div>
