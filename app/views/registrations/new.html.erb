<% content_for :title, t("nav.sign_up") %>

<div class="card form-narrow">
  <h1><%= t("auth.create_account") %></h1>

  <%= render "shared/errors", record: @user %>

  <%= form_with model: @user, url: signup_path do |form| %>
    <%= form.label :name %>
    <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name" %>

    <%= form.label :email_address %>
    <%= form.email_field :email_address, required: true, autocomplete: "username" %>

    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "new-password",
                            minlength: User::PASSWORD_MIN_LENGTH, maxlength: 72 %>
    <p class="hint"><%= t("auth.password_hint", count: User::PASSWORD_MIN_LENGTH) %></p>

    <%= form.label :password_confirmation %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>

    <div class="actions">
      <%= form.submit t("auth.create_account") %>
    </div>
  <% end %>

  <p class="hint"><%= t("auth.have_account") %> <%= link_to t("nav.sign_in"), new_session_path %></p>
</div>
