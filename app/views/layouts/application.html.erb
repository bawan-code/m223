<!DOCTYPE html>
<html lang="de">
  <head>
    <title><%= [content_for(:title), t("app.name")].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="<%= t("app.name") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <%= link_to t("app.name"), root_path, class: "brand" %>

      <%= form_with url: root_path, method: :get, class: "site-search" do |f| %>
        <%= f.search_field :q, value: params[:q], placeholder: t("nav.search"), "aria-label": t("nav.search") %>
        <%= f.submit "Suchen" %>
      <% end %>

      <nav class="site-nav">
        <% if current_user %>
          <% if policy(User).index? %>
            <%= link_to t("admin.users.title"), admin_users_path, class: "button button-secondary" %>
          <% end %>
          <%= link_to profile_path, class: "user-name" do %>
            <%= current_user.name %>
            <span class="muted">(<%= current_user.role_name %>)</span>
          <% end %>
          <%= button_to t("nav.sign_out"), session_path, method: :delete, class: "button button-secondary" %>
        <% else %>
          <%= link_to t("nav.sign_in"), new_session_path, class: "button button-secondary" %>
          <%= link_to t("nav.sign_up"), signup_path, class: "button" %>
        <% end %>
      </nav>
    </header>

    <main class="container">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
