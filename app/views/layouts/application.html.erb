<!DOCTYPE html>
<html lang="de">
  <head>
    <title><%= [content_for(:title), t("app.name")].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="<%= t("app.name") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <%= link_to t("app.name"), root_path, class: "brand" %>

      <%= form_with url: root_path, method: :get, class: "site-search" do |f| %>
        <%= f.search_field :q, value: params[:q], placeholder: t("nav.search"), "aria-label": t("nav.search") %>
        <%= f.submit "Suchen" %>
      <% end %>

      <nav class="site-nav">
        <% if current_user %>
          <% if policy(:activity).index? %>
            <%= link_to t("activities.title"), activities_path, class: "button button-secondary" %>
          <% end %>
          <% if policy(Report).index? %>
            <%= link_to t("moderation.title"), moderation_reports_path, class: "button button-secondary" %>
          <% end %>
          <% if policy(User).index? %>
            <%= link_to t("admin.users.title"), admin_users_path, class: "button button-secondary" %>
          <% end %>
          <%= link_to profile_path, class: "user-name" do %>
            <%= current_user.name %>
            <span class="muted">(<%= current_user.role_name %>)</span>
          <% end %>
          <%= button_to t("nav.sign_out"), session_path, method: :delete, class: "button button-secondary" %>
        <% else %>
          <%= link_to t("nav.sign_in"), new_session_path, class: "button button-secondary" %>
          <%= link_to t("nav.sign_up"), signup_path, class: "button" %>
        <% end %>
      </nav>
    </header>

    <main class="container">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <%# Hintergrund-Effekte im Stil von Outer Wilds, rein dekorativ. %>
    <div class="fx" aria-hidden="true">
      <i class="fx-sun"></i>
      <i class="fx-orbit" style="--r: 12vmax; --t: 24s; --s: 14px; --c: #ff9a4d"></i>
      <i class="fx-orbit" style="--r: 24vmax; --t: 40s; --s: 20px; --c: #5fcf7a; animation-delay: -12s"></i>
      <i class="fx-orbit" style="--r: 36vmax; --t: 60s; --s: 18px; --c: #8f7dff; animation-delay: -40s"></i>
      <i class="fx-orbit" style="--r: 48vmax; --t: 85s; --s: 34px; --c: #2fd0c0; animation-delay: -20s"></i>
      <i class="fx-orbit" style="--r: 60vmax; --t: 120s; --s: 26px; --c: #7d8aa0; animation-delay: -70s"></i>
      <i class="fx-meteor" style="--y: 6%; --t: 9s; animation-delay: -2s"></i>
      <i class="fx-meteor" style="--y: 32%; --t: 13s; animation-delay: -8s"></i>
      <i class="fx-meteor" style="--y: 55%; --t: 17s; animation-delay: -4s"></i>
      <i class="fx-meteor fx-comet" style="--y: 12%; --t: 26s; animation-delay: -6s"></i>
    </div>
    <button type="button" class="fx-switch" aria-pressed="false"><%= t("nav.effects") %></button>
  </body>
</html>
