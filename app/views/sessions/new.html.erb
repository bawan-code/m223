<% content_for :title, t("nav.sign_in") %>

<div class="card form-narrow">
  <h1><%= t("nav.sign_in") %></h1>

  <%= form_with url: session_path do |form| %>
    <%= form.label :email_address, User.human_attribute_name(:email_address) %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                         value: params[:email_address] %>

    <%= form.label :password, User.human_attribute_name(:password) %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>

    <div class="actions">
      <%= form.submit t("nav.sign_in") %>
    </div>
  <% end %>

  <p class="hint">
    <%= link_to t("auth.forgot_password"), new_password_path %> ·
    <%= t("auth.no_account") %> <%= link_to t("nav.sign_up"), signup_path %>
  </p>
</div>
