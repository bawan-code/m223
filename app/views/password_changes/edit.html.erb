<% content_for :title, t("profiles.change_password") %>

<div class="card form-narrow">
  <h1><%= t("profiles.change_password") %></h1>

  <%= render "shared/errors", record: @user %>

  <%= form_with url: password_change_path, method: :patch do |form| %>
    <%= form.label :current_password, t("profiles.current_password") %>
    <%= form.password_field :current_password, required: true, autofocus: true,
                            autocomplete: "current-password", maxlength: 72 %>

    <%= form.label :password, User.human_attribute_name(:password) %>
    <%= form.password_field :password, required: true, autocomplete: "new-password",
                            minlength: User::PASSWORD_MIN_LENGTH, maxlength: 72 %>
    <p class="hint"><%= t("auth.password_hint", count: User::PASSWORD_MIN_LENGTH) %></p>

    <%= form.label :password_confirmation, User.human_attribute_name(:password_confirmation) %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>

    <p class="hint"><%= t("profiles.other_sessions_hint") %></p>

    <div class="actions">
      <%= form.submit t("forms.save") %>
      <%= link_to t("forms.cancel"), profile_path, class: "button button-secondary" %>
    </div>
  <% end %>
</div>
