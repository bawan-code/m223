<% content_for :title, t("auth.forgot_password") %>

<div class="card form-narrow">
  <h1><%= t("auth.forgot_password") %></h1>
  <p class="hint"><%= t("auth.reset_hint") %></p>

  <%= form_with url: passwords_path do |form| %>
    <%= form.label :email_address, User.human_attribute_name(:email_address) %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                         value: params[:email_address] %>

    <div class="actions">
      <%= form.submit t("auth.send_reset") %>
      <%= link_to t("forms.cancel"), new_session_path, class: "button button-secondary" %>
    </div>
  <% end %>
</div>
