<%# Zeigt die Validierungsfehler eines Models oberhalb des Formulars %>
<% if record.errors.any? %>
  <div class="errors" role="alert">
    <strong><%= t("forms.errors", count: record.errors.count) %></strong>
    <ul>
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
