<% content_for :title, t("nav.profile") %>

<div class="card">
  <h1><%= t("nav.profile") %></h1>
  <p><strong><%= User.human_attribute_name(:name) %>:</strong> <%= @user.name %></p>
  <p><strong><%= User.human_attribute_name(:email_address) %>:</strong> <%= @user.email_address %></p>
  <p><strong><%= User.human_attribute_name(:role) %>:</strong> <%= @user.role_name %></p>
</div>
